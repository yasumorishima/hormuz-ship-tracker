# aisstream.io — free key at https://aisstream.io/
AISSTREAM_API_KEY=your_api_key_here

# Hugging Face write token, for the hosted pipeline (docs/PIPELINE.md).
# Not needed to run the local dashboard.
HF_TOKEN=

# Optional overrides; the container defaults are /app/data.
# AIS_DB_PATH=/app/data/ais.db
# AIS_OUTPUT_DIR=/app/data
# HF_DATASET_REPO=yasumorishima/hormuz-ais
